#
#
#  If you keep getting errors like:
#      Error: remote port forwarding failed for listen port 1234
#  probably a process is left hanging on the server, binding to the
#  loop-back port, to find it run this on the remote end:
#     sudo netstat -lp | grep 1234
#

# log_file=/var/log/services.log

log_it() {
    cmd_logger=/usr/local/bin/logger
    if [ -x "$cmd_logger" ]; then
        $cmd_logger "$RC_SVCNAME" "$*"
    else
        echo "$RC_SVCNAME [$$] $*"
    fi
}

depend() {
    if [ -f /etc/init.d/hostname ]; then
        need hostname
    fi
    # need runbg
    need sshd
}

start_post() {
    log_it started
}

stop_post() {
    log_it stopped
}

# shellcheck disable=SC2034 # command defined for openrc handling
command="/usr/bin/autossh"
pidfile="/run/${RC_SVCNAME}.pid"

export AUTOSSH_PIDFILE="$pidfile"
export AUTOSSH_LOGFILE="/var/log/autossh.log"

# To get more autossh logging, enable this
#export AUTOSH_DEBUG=1

#
#  Found this hint on the net, trying it...
#  When doing Remote Port forwards you’ll also want to use:
#  -o ExitOnForwardFailure=yes
#
#  Without this, if autossh detects the dropped connection before the
#  remote end notices (likely) the subsequent reconnect will be unable to
#  bind to your specified remote port because it’s still bound to the
#  stale SSH session. So the session will be up, but the reason for the
#  session (the port forward) will be unavailable. With this extra option
#  SSH immediately quits if that bind fails and autossh will just retry
#  until it succeeds (after the remote end detects the stale session).
#

#
#  Add this to command_args for extensive ssh session logging
#   -v -E /var/log/autossh-ssh.log \
#
#  autossh -f is needed for this init script to notice service is up
#  Soo annoying, sometimes it only connects if the ssh param is
#  -NT  at other times only if it is -N    (25-02-03 investigate this)
#

#
#  ---  what reverse port to use?  ---
#
# Match vs lowercase hostname
hostname_s_lower=$(/usr/local/bin/hostname -s | tr '[:upper:]' '[:lower:]')
# echo "using hostname [$hostname_s_lower]" >/dev/stderr
case "$hostname_s_lower" in
    # iPads
    jacpad) reverse_port=2280 ;;
    jacaok) reverse_port=2281 ;;
    pad7 | oldpad) reverse_port=2282 ;;
    pad5) reverse_port=2283 ;;
    jacmac-ish) reverse_port=2284 ;;
    jacmac-aok) reverse_port=2285 ;;

    # iPhones
    jacphone) reverse_port=2290 ;;
    jacold) reverse_port=2291 ;;

    # Android / Termux
    jacdroid) reverse_port=2278 ;; # should be moved to 2300 when no risk of disconnection

    # chroots
    kajsa-ish | hetz2-ish) reverse_port=2310 ;;

    *)
        msg="ERROR: reverse port not defined - set hostname or inspect /etc/init.d/autossh to fix"
        log_it "$msg"
        eerror "$msg"
        eend 1
        return 1
        ;;
esac

# Remember that the last item on the line must match your sshd port!
loopback_directive="$reverse_port:localhost:[SPD_SVC_SSHD_PORT]" # SPD_SVC_SSHD_PORT

autossh_opts="-M 0 -f \
    -NT \
    -o StrictHostKeyChecking=no \
    -o UserKnownHostsFile=/dev/null \
    -o ConnectTimeout=10 \
    -o ExitOnForwardFailure=yes \
    -o PasswordAuthentication=no \
    -o PubkeyAuthentication=yes \
    -o ServerAliveCountMax=3 \
    -o ServerAliveInterval=5 \
    -E /var/log/autossh-ssh.log \
    -R $loopback_directive"

key_file="[SPD_SVC_AUTOSSH_KEY_FILE]" # SPD_SVC_AUTOSSH_KEY_FILE
[ -n "$key_file" ] && autossh_opts="$autossh_opts -i $key_file"

jump_port="[SPD_SVC_AUTOSSH_JUMP_PORT]" # SPD_SVC_AUTOSSH_JUMP_PORT
[ -n "$jump_port" ] && autossh_opts="$autossh_opts -p $jump_port"

jump_account="[SPD_UNAME]@[SPD_SVC_AUTOSSH_JUMP_HOST]" # SPD_SVC_AUTOSSH_JUMP_HOST

# shellcheck disable=SC2034 # command_args defined for openrc handling
command_args="$autossh_opts $jump_account"
